# App Configuration
PORT=4000
NODE_ENV=development

# Firebase Admin Configuration
# Option 1: Direct credentials via environment variables (Recommended for production/CI)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to downloaded Service Account JSON file (Convenient for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=
